{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "trolay",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application",
		// Only the API runs the Worker; the app itself is served straight from the assets.
		"run_worker_first": ["/api/*"]
	},
	// The sync database (created with `wrangler d1 create trolay`). The Worker reads it as env.DB.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "trolay",
			"database_id": "5b47c928-40a9-47f5-871c-aa643fff63f5",
			"migrations_dir": "migrations"
		}
	],
	// Sign-in links are emailed with Cloudflare Email Service. Set MAIL_FROM to an address on a
	// domain you have set up for sending there (Email Service, then onboard the domain).
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"vars": {
		"MAIL_FROM": "Trolay <welcome@trolay.com>"
	},
	// Branch previews (`wrangler preview`, which Workers Builds runs for every branch but main) do
	// NOT inherit anything above: a binding left out here does not exist in a preview, and the API
	// answers 500 to anything that touches the database. So a preview gets the bindings below, and
	// its own database, `trolay-preview`, so a branch never touches real data. Apply migrations to
	// it with `pnpm db:migrate:preview` (a preview's code may need a migration production lacks).
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "trolay-preview",
				"database_id": "20948ccc-e39e-4acc-82c5-bf78d69ea3ee",
				"migrations_dir": "migrations"
			}
		],
		"send_email": [{ "name": "EMAIL" }],
		"vars": { "MAIL_FROM": "Trolay <welcome@trolay.com>" }
	}
}
