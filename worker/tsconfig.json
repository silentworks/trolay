{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"paths": { "#lib/*": ["../src/lib/*"] },
		"types": ["@cloudflare/workers-types", "node"]
	},
	// The sync tests are checked here too: they need the Worker and the app side by side.
	"include": [
		".",
		"../src/lib/sync/integration.spec.ts",
		"../src/lib/sync/harness.ts",
		"../src/lib/sync/harness.spec.ts"
	]
}
