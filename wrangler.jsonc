{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "trolay",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application",
		// Only the API runs the Worker; the app itself is served straight from the assets.
		"run_worker_first": ["/api/*"]
	},
	// The sync database. Before the first deploy, run `wrangler d1 create trolay` and add the
	// `database_id` it prints here; local development does not need it.
	"d1_databases": [{ "binding": "DB", "database_name": "trolay", "migrations_dir": "migrations" }],
	// Required by `wrangler preview` (non-production branch builds); top-level settings apply.
	"previews": {}
}
