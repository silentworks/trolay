# Cloudflare Workers static asset headers.
# The service worker and app shell must always be revalidated so a new version is found.
/service-worker.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
# Hashed build files never change.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
